# ===================================================================
# Aviator Pro - Environment Variables Configuration (.env.example)
# Copy this file to .env for local development or enter these in Render.
# ===================================================================

# Server Environment & Port (Assigned dynamically by Render, defaults to 3000 locally)
NODE_ENV="production"
PORT=3000

# Application URLs (Used for webhooks, CORS, and Telegram bot deep-links)
# In production on Render, set this to your live domain: https://aviatorpro-rsbr.onrender.com
APP_URL="https://aviatorpro-rsbr.onrender.com"
FRONTEND_URL="https://aviatorpro-rsbr.onrender.com"

# Cryptographic Secret for signing JWT session tokens (PBKDF2 + HMAC SHA-256)
SESSION_SECRET="replace-with-a-64-character-random-hex-secret-in-production"

# Initial Admin Credentials (username: admin)
ADMIN_INITIAL_PASSWORD="ChangeMeSecure2026!"

# UPI Payment Gateway Information for Manual Ledger Deposits
UPI_PAYMENT_ID="princesuhani@fam"

# Telegram Bot Integration
# 1. TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# 2. TELEGRAM_ADMIN_CHAT_ID: Verified Telegram User ID or Chat ID for instant admin notifications
# Example: 8630197412
TELEGRAM_ADMIN_CHAT_ID=""

# 3. BOT_USERNAME: Registered Telegram bot username
# Example: @aviatorprince0001_bot
BOT_USERNAME="@aviatorprince0001_bot"

# 4. TELEGRAM_MODE: 'polling' (long polling) or 'webhook'
TELEGRAM_MODE="polling"

# 5. TELEGRAM_ADMIN_IDS: Optional additional comma-separated list of allowed admin IDs
TELEGRAM_ADMIN_IDS=""

# Optional Database Connection String (PostgreSQL)
# When omitted, Aviator Pro automatically uses resilient atomic JSON persistence at ./data/aviator_db.json
DATABASE_URL=""

# ZapPay Online Payment Gateway Integration
# Link ID provided in payment URL (e.g. https://panel.zappay.shop/pay.html?id=3ad9a798)
ZAPPAY_LINK_ID="3ad9a798"
ZAPPAY_PAY_URL="https://panel.zappay.shop/pay.html?id=3ad9a798"
ZAPPAY_API_BASE="https://zappay-beta.vercel.app"

