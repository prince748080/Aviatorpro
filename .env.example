# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (used for webhooks and browser redirect links)
APP_URL="http://localhost:3000"

# PORT: Server HTTP and WebSocket port
PORT=3000

# SESSION_SECRET: Cryptographic secret used to sign session JWTs (change in production!)
SESSION_SECRET="change-this-to-a-very-long-random-secret-in-production"

# ADMIN_INITIAL_PASSWORD: Password for initial bootstrap admin account (username: admin)
ADMIN_INITIAL_PASSWORD="AviatorAdmin2026!"

# DATABASE_URL: Optional PostgreSQL connection URI (e.g. postgresql://user:pass@localhost:5432/aviator_db)
# If omitted or unavailable, the application seamlessly uses the resilient atomic JSON file database at ./data/aviator_db.json
DATABASE_URL=""

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_MODE: 'polling' for local dev or 'webhook' for production deployment
TELEGRAM_MODE="polling"

# TELEGRAM_ADMIN_IDS: Comma-separated list of Telegram User IDs granted /admin privileges
TELEGRAM_ADMIN_IDS="123456789,987654321"

# SUPPORT_CONTACT: Public customer support contact email
SUPPORT_CONTACT="support@aviatorpro.local"
